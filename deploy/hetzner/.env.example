# Yuvomi auf einem Mietserver hinter Caddy. Vorlage für bootstrap.sh;
# das Skript füllt DOMAIN, ACME_EMAIL, BASE_URL, GOOGLE_REDIRECT_URI und die
# beiden Schlüssel. Von Hand: kopieren nach .env und die REPLACE_-Werte setzen.

# --- Erreichbarkeit --------------------------------------------------------
# Die Domain, unter der der Haushalt die App öffnet. Muss per A-Record auf
# die Server-IP zeigen, bevor Caddy ein Zertifikat bekommt.
DOMAIN=REPLACE_WITH_DOMAIN
# Kontaktadresse für Let's Encrypt (Ablaufwarnungen, sonst nichts).
ACME_EMAIL=REPLACE_WITH_EMAIL
# Absolute Adresse für Einladungs- und Reset-Mails sowie Kalender-Feeds.
BASE_URL=https://REPLACE_WITH_DOMAIN
TZ=Europe/Berlin

# --- Image -----------------------------------------------------------------
# Upstream-Image. Für den eigenen Fork später z. B. ghcr.io/<user>/yuvomi:latest
# oder ein lokal gebautes Tag eintragen.
YUVOMI_IMAGE=ghcr.io/ulsklyc/yuvomi:latest

# --- Geheimnisse -----------------------------------------------------------
# openssl rand -hex 32  — ein Wechsel meldet nur alle einmal ab.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
# openssl rand -hex 32  — AUFSCHREIBEN. Ohne diesen Schlüssel ist die
# Datenbank nicht mehr lesbar, auch nicht aus einem Backup.
DB_ENCRYPTION_KEY=REPLACE_WITH_A_STRONG_ENCRYPTION_KEY

# --- Speicherorte auf dem Host ---------------------------------------------
DATA_DIR=./data
BACKUP_DIR=./backups
MODULES_DIR=./modules
DOCUMENT_STORAGE_LOCAL_DIR=./documents
DOCUMENT_STORAGE_LOCAL_ENABLED=false

# --- Backups ---------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP=14
# Optional: jedes Backup zusätzlich auf einen WebDAV-Speicher laden
# (Hetzner Storage Box, Nextcloud ...). Sehr empfohlen, sonst liegt alles auf
# einer einzigen Platte.
# WEBDAV_BACKUP_ENABLED=true
# WEBDAV_BACKUP_URL=https://uXXXXXX.your-storagebox.de/yuvomi/
# WEBDAV_BACKUP_USERNAME=
# WEBDAV_BACKUP_PASSWORD=

# --- Google Calendar -------------------------------------------------------
# Alle drei zusammen setzen, sonst zeigt die Kalender-Einstellung
# "Nicht konfiguriert". Anlegen in der Google Cloud Console, siehe README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://REPLACE_WITH_DOMAIN/api/v1/calendar/google/callback
SYNC_INTERVAL_MINUTES=15

# --- Sicherheit ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=5
# Module aus den Einstellungen installieren (ZIP / GitHub). Aus lassen, bis
# ein eigenes Modul gebraucht wird; Ordner nach modules/ kopieren geht immer.
MODULES_ALLOW_WEB_INSTALL=false
